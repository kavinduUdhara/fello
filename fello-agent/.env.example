# Gemini models (served natively by ADK) — the default provider.
# Locally: either set GOOGLE_API_KEY (from aistudio.google.com), or set
# GOOGLE_GENAI_USE_VERTEXAI=TRUE to use Vertex AI via gcloud ADC.
# On Agent Engine, deploy.py sets GOOGLE_GENAI_USE_VERTEXAI=TRUE — no key needed.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# NVIDIA NIM alternate provider — set MODEL_PROVIDER=nvidia to switch back.
# Key from build.nvidia.com — rotate before committing.
MODEL_PROVIDER=
NVIDIA_API_KEY=
NVIDIA_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b

# Google Cloud
GOOGLE_CLOUD_PROJECT=fello-pt
GOOGLE_CLOUD_LOCATION=us-central1
GCS_STAGING_BUCKET=gs://fello-pt-agent-staging

# Firebase Admin (local dev only — on Agent Engine, ADC is used automatically)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Baileys gateway (your GCE VM address)
BAILEYS_API_URL=
BAILEYS_API_SECRET=

# Cloud SQL / PostgreSQL — document index for weighted full-text retrieval.
# Leave empty to disable file search gracefully (the agent says so instead of erroring).
DATABASE_URL=

# Set on Agent Engine only — its serverless runtime has no stable egress IP to
# allowlist on Cloud SQL, so it connects via the Cloud SQL Python Connector
# (IAM auth) instead of a raw TCP connection. Format: "PROJECT:REGION:INSTANCE".
# Leave empty for local dev (falls back to a plain DATABASE_URL connection).
INSTANCE_CONNECTION_NAME=

# Google OAuth client (to refresh org Google tokens for Forms/Docs)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Backend relay for WhatsApp actions from the deployed agent (skills/_backend.py)
BACKEND_API_URL=
AGENT_BACKEND_SECRET=
# Existing Agent Engine resource — deploy.py updates it in place instead of creating a new one
AGENT_ENGINE_RESOURCE_NAME=
