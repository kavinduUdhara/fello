# NVIDIA NIM — rotate at build.nvidia.com before committing
NVIDIA_API_KEY=

# Primary model (GLM) — model ID as listed on your NVIDIA dashboard
NVIDIA_PRIMARY_MODEL=meta/llama-3.3-70b-instruct

# Fallback model (MiniMax) — used if primary fails
NVIDIA_FALLBACK_MODEL=meta/llama-3.1-8b-instruct

# Google Cloud
GOOGLE_CLOUD_PROJECT=fello-pt
GOOGLE_CLOUD_LOCATION=us-central1
GCS_STAGING_BUCKET=gs://fello-pt-agent-staging

# Firebase Admin (local dev only — on Agent Engine, ADC is used automatically)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Baileys gateway (your GCE VM address)
BAILEYS_API_URL=
BAILEYS_API_SECRET=

# Cloud SQL / PostgreSQL — document index for weighted full-text retrieval.
# Leave empty to disable file search gracefully (the agent says so instead of erroring).
DATABASE_URL=
